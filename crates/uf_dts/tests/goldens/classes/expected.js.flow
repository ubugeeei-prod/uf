declare export class Base<out T> {
  constructor(value: T): void;
  get value(): T;
}
export interface Service {
  start(): Promise<void>;
}
export interface MethodProperty {
  readonly execute: (input: string) => Promise<string>;
  readonly bound: (this: MethodProperty, input: string) => Promise<string>;
}
export type MethodPropertyAlias = MethodProperty;
export type OmitKeyof<out TObject, out TKey> = Omit<TObject, TKey>;
export type ReplaceReturnType<T, out R> = T extends (input: infer I) => any ? (input: I) => R : empty;
export interface ReplacedMethodProperty {
  readonly transform: ReplaceReturnType<(input: string) => string, Promise<number>>;
}
declare export abstract class Worker<out T = string> extends Base<T> implements Service {


  guarded: number;
  static instances: number;
  readonly id: string;
  label?: string;
  constructor(value: T): void;
  constructor(value: T, id: string): void;
  start(): Promise<void>;
  abstract run(input: T): void;
  optional?: () => void;
  static create<U>(value: U): Worker<U>;
  get size(): number;
  set size(value: number): void;
  [key: string]: mixed;

  @@iterator(): Iterator<T, any, any>;

}
declare export class Merged {
  fromClass: string;


  readonly fromInterface: number;
}
declare export class Scheduler implements MethodProperty {
  execute: (input: string) => Promise<string>;
  bound: (this: MethodProperty, input: string) => Promise<string>;
}
declare export class OmittedScheduler implements Omit<MethodProperty, "bound"> {
  execute: (input: string) => Promise<string>;
}
declare export class KeyofOmittedScheduler implements OmitKeyof<MethodProperty, "bound"> {
  execute: (input: string) => Promise<string>;
}
declare export class PickedScheduler implements Pick<MethodProperty, "execute"> {
  execute: (input: string) => Promise<string>;
}
declare export class AliasScheduler implements MethodPropertyAlias {
  execute: (input: string) => Promise<string>;
  bound: (this: MethodProperty, input: string) => Promise<string>;
}
declare export class TransformScheduler implements ReplacedMethodProperty {
  transform: (input: string) => Promise<number>;
}
declare export function mixin<T>(base: T): T;
declare export class Mixed {
}
