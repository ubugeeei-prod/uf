export type Pair = [string, number];
export type Named = [first: string, second?: number];
export type Optional = [string, number?];
export type Spread<out T extends Array<mixed>> = [head: string, ...tail: T];
export type ArrayRest = any;
export type NamedArrayRest = any;
export type Frozen = $ReadOnly<[string, number]>;
export type FrozenList = $ReadOnlyArray<string>;
export type List = Array<string>;
export type Nested = [[string], interface { readonly inner: [number]; }];
