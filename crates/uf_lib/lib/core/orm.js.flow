// @flow

declare export opaque type Table<Row: { +[string]: mixed }>;
declare export opaque type Column<T>;
declare export opaque type Query<Row: { +[string]: mixed }>;
declare export opaque type Migration;

declare export type ColumnType =
  | "text"
  | "int64"
  | "boolean"
  | "json"
  | "timestamp"
  | "uuid";

declare export type OrmContract = {
  +driver: "sqlite" | "postgres" | "mysql",
  +preparedByDefault: true,
  +generatedFlowTypes: true,
  +parameterizedQueriesOnly: true,
};

declare export function column<T>(name: string, ty: ColumnType): Column<T>;
declare export function primaryKey<T>(column: Column<T>): Column<T>;
declare export function nullable<T>(column: Column<T>): Column<?T>;
declare export function defineTable<Row: { +[string]: mixed }>(
  name: string,
  columns: { +[string]: Column<mixed> },
): Table<Row>;
declare export function relation<From: { +[string]: mixed }, To: { +[string]: mixed }>(
  from: Table<From>,
  to: Table<To>,
): void;
declare export function query<Row: { +[string]: mixed }>(table: Table<Row>): Query<Row>;
declare export function whereEq<Row: { +[string]: mixed }, Value>(
  query: Query<Row>,
  column: Column<Value>,
  value: Value,
): Query<Row>;
declare export function limit<Row: { +[string]: mixed }>(query: Query<Row>, count: number): Query<Row>;
declare export function migration(name: string): Migration;
declare export var db: {
  query<Row: { +[string]: mixed }>(query: Query<Row>): Promise<$ReadOnlyArray<Row>>,
};
declare export function contract(): OrmContract;
