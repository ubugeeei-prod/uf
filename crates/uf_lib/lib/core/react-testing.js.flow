// @flow
import type * as React from './react.js.flow';

declare export interface RenderResult {
  rerender(ui: React.Node): void,
  unmount(): void,
}

declare export interface Screen {
  getByText(text: string | RegExp): HTMLElement,
  findByText(text: string | RegExp): Promise<HTMLElement>,
  queryByText(text: string | RegExp): null | HTMLElement,
}

declare export var screen: Screen;
declare export function render(ui: React.Node): RenderResult;
declare export function waitFor<T>(body: () => T | Promise<T>): Promise<T>;
declare export var fireEvent: { [string]: (target: EventTarget, event?: mixed) => void };
declare export var userEvent: { [string]: (...args: $ReadOnlyArray<mixed>) => Promise<void> };
