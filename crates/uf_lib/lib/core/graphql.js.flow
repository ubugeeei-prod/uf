// @flow
import type { FetchClient } from "./fetch.js.flow";

declare export opaque type GraphQlOperation<TData, TVariables>;

declare export type GraphQlClient = {
  +fetch: FetchClient,
  +relayBase: true,
};

declare export function graphql<TData, TVariables: {...}>(
  text: string,
): GraphQlOperation<TData, TVariables>;

declare export function createGraphQlClient(config: { +fetch: FetchClient }): GraphQlClient;
declare export function useLazyLoadQuery<TData, TVariables: {...}>(
  operation: GraphQlOperation<TData, TVariables>,
  variables: TVariables,
): Promise<TData>;
