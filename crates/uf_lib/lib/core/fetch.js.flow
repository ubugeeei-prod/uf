// @flow

declare export opaque type FetchClient;
declare export type FetchConfig = {
  +baseURL?: string,
  +headers?: { +[string]: string },
};

declare export function ofetch(config?: FetchConfig): FetchClient;
declare export function createFetch(config?: FetchConfig): FetchClient;
declare export function request<T>(
  client: FetchClient,
  path: string,
  init?: RequestOptions,
): Promise<T>;

declare export type RequestOptions = {
  +method?: "GET" | "POST" | "PUT" | "PATCH" | "DELETE",
  +body?: mixed,
  +headers?: { +[string]: string },
};
