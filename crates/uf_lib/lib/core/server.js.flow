// @flow

declare export opaque type ServerAction<TArgs: $ReadOnlyArray<mixed>, TReturn>;

declare export function serverAction<TArgs: $ReadOnlyArray<mixed>, TReturn>(
  action: (...TArgs) => Promise<TReturn> | TReturn,
): (...TArgs) => Promise<TReturn>;
declare export function headers(): { get(name: string): null | string };
declare export function cookies(): { get(name: string): null | string };
declare export function cache<T>(key: string, body: () => T | Promise<T>): Promise<T>;
declare export function draftMode(): {
  +isEnabled: boolean,
  +enable: () => void,
  +disable: () => void,
};
declare export function after(callback: () => mixed | Promise<mixed>): void;
