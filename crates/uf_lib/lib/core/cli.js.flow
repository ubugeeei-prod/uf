// @flow

declare export opaque type CliApp;
declare export opaque type CliCommand;
declare export opaque type CliArgument;
declare export opaque type CliOption;

declare export function defineCli(name: string): CliApp;
declare export function command(name: string): CliCommand;
declare export function arg(name: string): CliArgument;
declare export function option(name: string): CliOption;
