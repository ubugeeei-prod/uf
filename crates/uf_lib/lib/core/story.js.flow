// @flow
import type * as React from "./react.js.flow";
import type { BrowserPlan } from "./browser.js.flow";
import type { MockRegistry } from "./mock.js.flow";

declare export opaque type Storybook;

declare export type StoryVariant<Props: {...}> = {
  +name: string,
  +props: Props,
};

declare export function story<Props: {...}>(
  id: string,
  render: component(...Props) renders React.Node,
): Storybook;

declare export function variant<Props: {...}>(
  storybook: Storybook,
  variant: StoryVariant<Props>,
): Storybook;

declare export function withMocks(storybook: Storybook, mocks: MockRegistry): Storybook;
declare export function withBrowser(storybook: Storybook, browser: BrowserPlan): Storybook;
