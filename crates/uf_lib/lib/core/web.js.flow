// @flow
import type * as React from "./react.js.flow";

declare export type LinkPrefetch = "off" | "intent" | "render";
declare export type RoutePath = string;
declare export type RouteParams = { +[string]: string };

declare export type LinkProps<TRoute: RoutePath> = {
  +to: TRoute,
  +prefetch?: LinkPrefetch,
  +children?: React.Node,
};

declare export component Font(src: string, family: string, preload?: boolean);
declare export component Image(src: string, alt: string, width?: number, height?: number);
declare export component OgImage(title: string, description?: string);
declare export component Link<TRoute: RoutePath>(
  to: TRoute,
  prefetch?: LinkPrefetch,
  children?: React.Node,
) renders React.Node;
declare export component Page(children?: React.Node) renders React.Node;
declare export component Layout(children?: React.Node) renders React.Node;
declare export component Time(value: Date | string, format?: string) renders React.Node;
declare export component Announcer(children?: React.Node) renders React.Node;
declare export component Picture(src: string, alt: string, sources?: $ReadOnlyArray<string>) renders React.Node;

declare export function useCookie<T>(
  name: string,
  options?: { +httpOnly?: boolean, +sameSite?: "lax" | "strict" | "none" },
): [null | T, (next: T) => void];

declare export function useHead(head: {
  +title?: string,
  +meta?: $ReadOnlyArray<{ +name: string, +content: string }>,
  +links?: $ReadOnlyArray<{ +rel: string, +href: string }>,
}): void;

declare export function useRoute<TRoute: RoutePath, TParams: RouteParams>(): {
  +path: TRoute,
  +params: TParams,
};

declare export function useRouter<TRoute: RoutePath>(): {
  +push: (to: TRoute) => void,
  +replace: (to: TRoute) => void,
  +prefetch: (to: TRoute) => Promise<void>,
};

declare export function defineNavigationGuard<TRoute: RoutePath>(
  guard: (to: TRoute, from: TRoute) => boolean | Promise<boolean>,
): (to: TRoute, from: TRoute) => Promise<boolean>;
