// @flow

declare export type StdCategory =
  | "file-system"
  | "types"
  | "pipeline"
  | "environment"
  | "diagnostics"
  | "data"
  | "network"
  | "serialization"
  | "platform"
  | "cloud";

declare export type StdModule = {
  +specifier: string,
  +category: StdCategory,
  +wintertcAligned: true,
  +nativeBinding: true,
  +exports: $ReadOnlyArray<string>,
};

declare export type Result<Ok, Err> =
  | { +ok: true, +value: Ok }
  | { +ok: false, +error: Err };

declare export opaque type Brand<Name: string, T>: T;
declare export type JsonValue = null | boolean | number | string | $ReadOnlyArray<JsonValue> | { +[string]: JsonValue };

declare export type VirtualPath = { +path: string };
declare export type QueryPair = { +key: string, +value: string };
declare export type ByteBuffer = { +bytes: Uint8Array };
declare export type ImportMeta = { +url: string, +dirname?: string, +filename?: string };
declare export type DeferPhase = "microtask" | "idle" | "post-response";
declare export type DeferredTask = { +id: string, +phase: DeferPhase };
declare export type HttpMethod = "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
declare export type HttpRoute = { +method: HttpMethod, +path: string };
declare export type WebSocketMode = "web-socket" | "web-socket-stream";
declare export type SqlDriverKind = "sqlite" | "postgres" | "mysql";
declare export type SqlDriver = { +kind: SqlDriverKind, +preparedByDefault: true };
declare export type DigestAlgorithm = "fast-hash" | "sha256";
declare export type OsFamily = "mac-os" | "linux" | "windows" | "unknown";
declare export type OsInfo = { +family: OsFamily, +arch: string, +availableParallelism: number };
declare export type DnsRecordType = "A" | "AAAA" | "CNAME" | "MX" | "TXT";
declare export type DnsQuery = { +name: string, +recordType: DnsRecordType };
declare export type StreamKind = "readable" | "writable" | "transform";
declare export type StreamDescriptor = { +kind: StreamKind, +backpressure: true };
declare export type UrlParts = { +scheme: string, +host: string, +path: string };
declare export type WasmModulePlan = { +name: string, +aheadOfTime: true };
declare export type GlobPattern = { +pattern: string, +dotfiles: boolean };
declare export type MotionEase = "linear" | "out" | "spring";
declare export type MotionTransition = {
  +durationMs: number,
  +ease: MotionEase,
  +respectsReducedMotion: true,
};
declare export type TerminalColorDepth = "ansi16" | "ansi256" | "true-color";
declare export type TerminalCapabilities = {
  +columns: number,
  +rows: number,
  +colorDepth: TerminalColorDepth,
  +unicode: boolean,
  +mouse: boolean,
  +inlineImages: boolean,
  +sixel: boolean,
};
declare export type CronSchedule = {
  +minute: string,
  +hour: string,
  +dayOfMonth: string,
  +month: string,
  +dayOfWeek: string,
};
declare export type S3ObjectRequest = { +bucket: string, +key: string, +sigv4: true };
declare export type SigV4Scope = { +region: string, +service: string };
declare export type FunctionRuntime = "worker" | "lambda";
declare export type FunctionDescriptor = {
  +name: string,
  +runtime: FunctionRuntime,
  +entry: string,
};
declare export type UuidVersion = "v4" | "v7";
declare export type ZipCompression = "store" | "deflate";
declare export type ZipEntry = { +path: string, +compression: ZipCompression, +size: number };

declare export function modules(): $ReadOnlyArray<StdModule>;
declare export function wintertc(): "winter-tc";
declare export function virtualPath(path: string): VirtualPath;
declare export function lazy(name: string): mixed;
declare export function defer(id: string, phase?: DeferPhase): DeferredTask;
declare export function parseDotEnv(source: string): $ReadOnlyArray<{ +key: string, +value: string }>;
declare export function colorize(value: string, style: "bold" | "dim" | "red" | "green" | "cyan", enabled?: boolean): string;
declare export function fastHash(value: string | Uint8Array): number;
declare export function timingSafeEqual(left: Uint8Array, right: Uint8Array): boolean;
declare export function bufferFromUtf8(value: string): ByteBuffer;
declare export function toHex(buffer: ByteBuffer): string;
declare export function parseQuery(query: string): $ReadOnlyArray<QueryPair>;
declare export function stringifyQuery(query: $ReadOnlyArray<QueryPair>): string;
declare export function parseJson(source: string): JsonValue;
declare export function stringifyJson(value: JsonValue): string;
declare export function parseToml(source: string): mixed;
declare export function detectYaml(source: string): "mapping" | "sequence" | "scalar" | "empty";
declare export function clamp(value: number, min: number, max: number): number;
declare export function lerp(start: number, end: number, amount: number): number;
declare export function osInfo(family: OsFamily, arch: string, availableParallelism: number): OsInfo;
declare export function dnsQuery(name: string, recordType: DnsRecordType): DnsQuery;
declare export function joinPath(parts: $ReadOnlyArray<string>): string;
declare export function normalizePath(path: string): string;
declare export function stream(kind: StreamKind): StreamDescriptor;
declare export function parseUrl(value: string): ?UrlParts;
declare export function wasmModule(name: string): WasmModulePlan;
declare export function glob(pattern: string): GlobPattern;
declare export function motion(durationMs: number, ease: MotionEase): MotionTransition;
declare export function terminalCapabilities(columns: number, rows: number): TerminalCapabilities;
declare export function parseCron(source: string): ?CronSchedule;
declare export function s3Object(bucket: string, key: string): S3ObjectRequest;
declare export function sigv4Scope(region: string, service: string): SigV4Scope;
declare export function defineFunction(name: string, runtime: FunctionRuntime, entry: string): FunctionDescriptor;
declare export function digest(algorithm: DigestAlgorithm, bytes: Uint8Array): string;
declare export function parseUuid(value: string): ?{ +value: string, +version?: number };
declare export function importMeta(url: string): ImportMeta;
