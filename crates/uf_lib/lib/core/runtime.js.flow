// @flow

declare export type RuntimeEngine =
  | 'uf'
  | 'node'
  | 'bun'
  | 'deno'
  | 'edge'
  | 'serverless'
  | 'container';

declare export type DeployAdapter =
  | 'node'
  | 'bun'
  | 'deno'
  | 'edge'
  | 'serverless'
  | 'static'
  | 'container';

declare export type RuntimeCapability =
  | 'fetch'
  | 'streams'
  | 'request-response'
  | 'url'
  | 'headers'
  | 'cookies'
  | 'timers'
  | 'file-system'
  | 'tcp'
  | 'udp'
  | 'tls'
  | 'dns'
  | 'cron'
  | 's3'
  | 'sigv4'
  | 'functions'
  | 'web-assembly'
  | 'workers'
  | 'server-actions'
  | 'react-server-components'
  | 'native-packages'
  | 'terminal-ui';

declare export function run(entry: string): Promise<void>;
declare export function resolve(specifier: string, from?: string): Promise<string>;
declare export function spawn(
  entry: string,
  options?: $ReadOnly<{ +runtime?: RuntimeEngine, +adapter?: DeployAdapter }>,
): Promise<void>;
