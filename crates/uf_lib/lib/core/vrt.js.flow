// @flow
import type { VisualSnapshot } from "./browser.js.flow";

declare export type VrtEngine = "uf-native-playwright-compatible";
declare export type DiffAlgorithm = "pixelmatch-compatible";
declare export type BaselinePolicy = "fail-on-missing" | "explicit-update-only";

declare export type VisualRegressionPlan = {
  +engine: VrtEngine,
  +baselines: string,
  +threshold: number,
  +diff: DiffAlgorithm,
  +baselinePolicy: BaselinePolicy,
  +snapshots: $ReadOnlyArray<VisualSnapshot>,
};

declare export function plan(snapshots?: $ReadOnlyArray<VisualSnapshot>): VisualRegressionPlan;
declare export function snapshot(storyId: string, viewport: string): VisualSnapshot;
declare export function diff(plan: VisualRegressionPlan): VisualRegressionPlan;
declare export function baseline(path: string): VisualRegressionPlan;
