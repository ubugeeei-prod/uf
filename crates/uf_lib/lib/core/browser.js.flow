// @flow

declare export type Viewport = {
  +name: string,
  +width: number,
  +height: number,
  +deviceScaleFactor?: number,
};

declare export type VisualSnapshot = {
  +storyId: string,
  +viewport: string,
  +baseline: string,
};

declare export opaque type BrowserPlan;

declare export function browser(): BrowserPlan;
declare export function viewport(viewport: Viewport): BrowserPlan;
declare export function visit(path: string): BrowserPlan;
declare export function screenshot(name: string): BrowserPlan;
