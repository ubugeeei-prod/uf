{
  "$schema": "https://unpkg.com/wrangler@4.128.0/config-schema.json",
  "name": "uf-setup",
  "main": "workers/setup.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "setup-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
