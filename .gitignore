/target/
# Written by `uf test --coverage`, at the root of whichever project was
# measured; `lcov.info` is what CI uploads and nothing in the repository reads
# it back. Unanchored, because `docs` is a project of its own.
coverage/
/dist/
/docs/dist/
/docs/router.js
/docs/server-actions.js
# The application `uf preview` and `uf start` are tested against. It builds in
# place rather than in a temporary directory, because a project that imports
# `@uniflowed/*` needs `node_modules` above it; everything below is written by
# `uf build` and rewritten on every run.
/crates/uf_cli/tests/fixtures/served-app/dist/
/crates/uf_cli/tests/fixtures/served-app/router.js
/crates/uf_cli/tests/fixtures/served-app/server-actions.js
# The application the server/client bundle split is measured against, built in
# place for the same reason.
/crates/uf_cli/tests/fixtures/rsc-split-app/dist/
/crates/uf_cli/tests/fixtures/rsc-split-app/router.js
/crates/uf_cli/tests/fixtures/rsc-split-app/server-actions.js
/server-actions.js
node_modules/
.uf/
/.wrangler/
# `wrangler dev` writes its state beside the config it was given, and
# `infra/cloudflare/wrangler.root.jsonc` is one anybody can run locally — the
# apex worker needs no account to serve. The anchored entry above does not
# reach it.
infra/cloudflare/.wrangler/
/.direnv/
.terraform/
*.tfplan
*.tfstate
*.tfstate.*
/.DS_Store
*.log
*.tmp
/docs/public/

# The Flow that `module-mock.test.js` hands to `uf check`: a module, a correct
# mock of it, and a deliberately wrong one. Written in place rather than in a
# temporary directory, for the reason the served application above is — it
# imports `@uniflowed/test` by path, and `uf check` only checks files the
# project scan found. The test removes it before it writes and again when it is
# done; this covers the run that was killed in between.
#
# Beside the test, which is now inside the package it tests. That is also why
# it is `.`-prefixed and why this entry matters more than it did: the directory
# sits in a tree npm publishes from, and `packages/test`'s `files` allowlist
# names the entries it packs rather than excluding what it does not — so this
# is about `git status`, and the allowlist is what keeps it off the registry.
/packages/test/.uf-module-mock-types/

# The formatter corpus: ~1 GB of third-party Flow, checked out by
# `tools/corpus/sync.sh` from `tools/corpus/repos.txt`. Every entry is a pin
# in that file and nothing here is tracked; the four that used to be
# submodules stopped being an exception in #137.
/tests/fixtures/git/*

# Upstream integration sources, fetched on request by
# `tools/upstream/sync.sh --integrations` from `tools/upstream/repos.txt`.
# `upstream/flow` is a submodule and is tracked; ignore rules do not apply to it.
/upstream/*
