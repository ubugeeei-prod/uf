    {
      "engine": "postgresql",
      "schema": "cases/options-postgresql/schema.sql",
      "queries": "cases/options-postgresql/query.sql",
      "codegen": [
        {
          "out": "cases/options-postgresql/gen",
          "plugin": "flow",
          "options": {
            "int8": "number",
            "timestamptz": "string",
            "rename": {
              "spotify_url": "spotifyURL"
            },
            "overrides": [
              {
                "column": "accounts.settings",
                "type": {
                  "import": "./cases/options-postgresql/types.js",
                  "name": "Settings",
                  "decode": "parseSettings"
                }
              },
              {
                "db_type": "uuid",
                "type": {
                  "import": "./cases/options-postgresql/types.js",
                  "name": "ExternalId",
                  "decode": "toExternalId",
                  "encode": "fromExternalId"
                }
              }
            ]
          }
        }
      ]
    }
