{
  "name": "@uniflowed/router",
  "version": "0.9.0",
  "description": "The file-system router for Flow React applications: matching, layouts, loaders, navigation, server rendering and hydration.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "npm/router"
  },
  "exports": {
    ".": {
      "react-server": "./server-components.js",
      "default": "./index.js"
    },
    "./action": "./action.js",
    "./client": "./client.js",
    "./native": "./native.js",
    "./rsc": "./rsc.js",
    "./rsc/client": "./rsc-client.js",
    "./rsc/ssr": "./rsc-ssr.js",
    "./server": "./server.js",
    "./routing": "./routing.js",
    "./package.json": "./package.json",
    "./handler": "./handler.js",
    "./middleware": "./middleware.js",
    "./native-navigation": "./native-navigation.js",
    "./http-client": "./http-client.js",
    "./instrumentation": "./instrumentation.js",
    "./testing": "./testing.js"
  },
  "files": [
    "action.js",
    "client.js",
    "handler.js",
    "index.js",
    "internal",
    "middleware.js",
    "native.js",
    "routing.js",
    "rsc-client.js",
    "rsc-ssr.js",
    "rsc.js",
    "server-components.js",
    "server.js",
    "native-navigation.js",
    "http-client.js",
    "instrumentation.js",
    "testing.js",
    "!*.test.js"
  ],
  "peerDependencies": {
    "react": ">=19.2.3",
    "react-dom": ">=19.2.3",
    "react-server-dom-parcel": ">=19.3.0",
    "react-native": ">=0.86",
    "@react-navigation/native": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-server-dom-parcel": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@react-navigation/native": {
      "optional": true
    }
  },
  "dependencies": {
    "@uniflowed/hooks": "0.9.0",
    "@uniflowed/server": "0.9.0",
    "@uniflowed/validator": "0.9.0"
  }
}
