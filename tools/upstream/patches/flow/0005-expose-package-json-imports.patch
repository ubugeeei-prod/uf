     }
+
+    pub fn parse_imports(expr: &ast::expression::Expression<Loc, Loc>) -> Option<Self> {
+        match expr.deref() {
+            ExpressionInner::Object { inner, .. } => {
+                Some(parse_package_exports_obj(&inner.properties))
+            }
+            _ => None,
+        }
+    }
 }
 
