; React is deliberately not installed here.
;
; Ink and `@uniflowed/tui` have to run in the *same* React for the comparison
; to mean anything: two copies in one process means two hook dispatchers, and
; the second renderer to mount finds a null one. The repository root already
; has the React that `@uniflowed/react` uses, and Node's upward resolution
; finds it from here — so Ink's peer is satisfied by the workspace rather than
; by a second copy under this directory.
legacy-peer-deps=true
