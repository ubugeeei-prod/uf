// @flow

declare export function useAsync<T>(body: () => Promise<T>, deps: $ReadOnlyArray<mixed>): {
  +value: null | T,
  +error: null | Error,
  +pending: boolean,
};
declare export function useDebouncedValue<T>(value: T, delayMs: number): T;
declare export function useEvent<TEvent>(handler: (event: TEvent) => mixed): (event: TEvent) => void;
declare export function useInterval(callback: () => mixed, delayMs: null | number): void;
declare export function useIsomorphicLayoutEffect(
  setup: () => void | (() => void),
  deps: $ReadOnlyArray<mixed>,
): void;
declare export function useLocalStorage<T>(key: string, initial: T): [T, (next: T) => void];
declare export function useMediaQuery(query: string): boolean;
declare export function useMounted(): boolean;
declare export function usePrevious<T>(value: T): void | T;
declare export function useStableCallback<TArgs: $ReadOnlyArray<mixed>, TReturn>(
  callback: (...TArgs) => TReturn,
): (...TArgs) => TReturn;
declare export function useServerValue<T>(value: T): T;
