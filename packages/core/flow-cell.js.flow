// @flow

declare export interface Cell<T> {
  get(): T,
  set(value: T): void,
  subscribe(listener: (value: T) => void): () => void,
}

declare export function cell<T>(initial: T): Cell<T>;
declare export function computed<T>(body: () => T): Cell<T>;
declare export function resource<T>(body: () => Promise<T>): Cell<null | T>;
