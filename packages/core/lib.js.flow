// @flow

declare export type NativeModuleKind =
  | 'data'
  | 'effect'
  | 'framework'
  | 'hooks'
  | 'runtime'
  | 'style'
  | 'testing'
  | 'ui';

declare export type NativeModule = {
  +specifier: string,
  +kind: NativeModuleKind,
  +stability: 'experimental' | 'planned' | 'stable',
  +flowExports: $ReadOnlyArray<string>,
};

declare export var version: string;
declare export function modules(): $ReadOnlyArray<NativeModule>;
