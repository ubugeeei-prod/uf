// @flow

declare export type RuleSeverity = 'off' | 'warn' | 'error';
declare export type RuleContext = {
  +filename: string,
  +source: string,
};
declare export type RuleDiagnostic = {
  +rule: string,
  +message: string,
  +line: number,
  +column: number,
};
declare export type NativeRule = (context: RuleContext) => $ReadOnlyArray<RuleDiagnostic>;

declare export function defineRule(name: string, rule: NativeRule): NativeRule;
declare export function typeAwareRule(name: string, rule: NativeRule): NativeRule;
declare export function reactRule(name: string, rule: NativeRule): NativeRule;
