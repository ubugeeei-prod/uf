{
  "name": "@uniflowed/test",
  "version": "0.0.0-alpha.45",
  "description": "The test API and worker for `uf test`: describe/it, a full matcher set, and the process uf fans test files out to.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "packages/test"
  },
  "exports": {
    ".": {
      "uniflowed-bun-test": "./bun/index.js",
      "default": "./index.js"
    },
    "./in-source": "./in-source.js",
    "./worker": "./worker.js",
    "./browser-worker": "./browser-worker.js",
    "./package.json": "./package.json",
    "./app": {
      "browser": "./app-browser.js",
      "default": "./app.js"
    },
    "./browser": "./browser.js"
  },
  "files": [
    "browser-worker.js",
    "bun",
    "in-source.js",
    "index.js",
    "internal",
    "worker.js",
    "app.js",
    "browser.js",
    "app-browser.js",
    "!*.test.js"
  ],
  "dependencies": {
    "@uniflowed/host": "0.0.0-alpha.45",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "axe-core": ">=4"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "browser": {
    "node:async_hooks": "./internal/browser/node.js",
    "node:fs": "./internal/browser/node.js",
    "node:module": "./internal/browser/node.js",
    "node:path": "./internal/browser/node.js",
    "node:url": "./internal/browser/node.js",
    "node:util": "./internal/browser/node.js",
    "./internal/browser/transport.js": "./internal/browser/page-transport.js"
  }
}
