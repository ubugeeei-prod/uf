{
  "name": "@uniflowed/router",
  "version": "0.0.0-alpha.34",
  "description": "The file-system router for Flow React applications: matching, layouts, loaders, navigation, server rendering and hydration.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "packages/router"
  },
  "exports": {
    ".": {
      "react-server": "./server-components.js",
      "default": "./index.js"
    },
    "./action": "./action.js",
    "./client": "./client.js",
    "./native": "./native.js",
    "./rsc": "./rsc.js",
    "./server": "./server.js",
    "./routing": "./routing.js",
    "./package.json": "./package.json",
    "./handler": "./handler.js",
    "./middleware": "./middleware.js"
  },
  "files": [
    "action.js",
    "client.js",
    "handler.js",
    "index.js",
    "internal",
    "middleware.js",
    "native.js",
    "routing.js",
    "rsc.js",
    "server-components.js",
    "server.js",
    "!*.test.js"
  ],
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0",
    "react-server-dom-parcel": ">=19.3.0"
  },
  "dependencies": {
    "@uniflowed/hooks": "0.0.0-alpha.34",
    "@uniflowed/server": "0.0.0-alpha.34"
  }
}
