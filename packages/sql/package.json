{
  "name": "@uniflowed/sql",
  "version": "0.7.0",
  "private": true,
  "description": "The runtime for sqlc's Flow target: exact codecs and driver adapters, part of the Unified Toolchain for Flow.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "packages/sql"
  },
  "exports": {
    ".": "./index.js",
    "./postgresql": "./postgresql.js",
    "./mysql": "./mysql.js",
    "./sqlite": "./sqlite.js",
    "./node-sqlite": "./adapters/node-sqlite.js",
    "./bun-sqlite": "./adapters/bun-sqlite.js",
    "./better-sqlite3": "./adapters/better-sqlite3.js",
    "./d1": "./adapters/d1.js",
    "./pglite": "./adapters/pglite.js",
    "./pg": "./adapters/pg.js",
    "./postgres": "./adapters/postgres.js",
    "./mysql2": "./adapters/mysql2.js"
  },
  "files": [
    "*.js",
    "adapters",
    "internal",
    "!*.test.js"
