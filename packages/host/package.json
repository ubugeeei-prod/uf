{
  "name": "@uniflowed/host",
  "version": "0.0.0-alpha.38",
  "description": "Running Flow on a Capability JS Host, with no bundler in the way.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "packages/host"
  },
  "exports": {
    "./assets": "./assets.js",
    "./bun-preload": "./bun-preload.js",
    "./deno-preload": "./deno-preload.js",
    "./internal/node-hooks.js": "./internal/node-hooks.js",
    "./internal/sync-hooks.js": "./internal/sync-hooks.js",
    "./lint-worker": "./lint-worker.js",
    "./module-mocks": "./module-mocks.js",
    "./register": "./register.js",
    "./transform": "./transform.js",
    "./write-atomically": "./write-atomically.js"
  },
  "browser": {
    "node:child_process": "./internal/browser-module.js",
    "node:fs": "./internal/browser-module.js",
    "node:module": "./internal/browser-module.js",
    "node:os": "./internal/browser-module.js",
    "node:path": "./internal/browser-module.js",
    "node:readline": "./internal/browser-module.js",
    "node:url": "./internal/browser-module.js"
  },
  "files": [
    "register.js",
    "assets.js",
    "bun-preload.js",
    "deno-preload.js",
    "lint-worker.js",
    "module-mocks.js",
    "transform.js",
    "write-atomically.js",
    "internal/*.js",
    "!*.test.js"
  ]
}
