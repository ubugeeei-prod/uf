{
  "name": "@uniflowed/vite",
  "version": "0.0.0-alpha.41",
  "description": "Vite, driven by uf.config.js: every Flow module through `uf transform`, MDX, the file-system router and static rendering as Vite plugins.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "packages/vite"
  },
  "uf": {
    "builder": {
      "driver": "./driver.js",
      "preload": {
        "bun": "@uniflowed/host/bun-preload"
      }
    }
  },
  "exports": {
    ".": "./index.js",
    "./driver": "./driver.js",
    "./package.json": "./package.json",
    "./merge": "./merge.js"
  },
  "files": [
    "driver.js",
    "index.js",
    "internal",
    "merge.js",
    "!*.test.js"
  ],
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^3.23.0",
    "@uniflowed/host": "0.0.0-alpha.41",
    "@uniflowed/router": "0.0.0-alpha.41",
    "@uniflowed/server": "0.0.0-alpha.41",
    "@uniflowed/validator": "0.0.0-alpha.41",
    "babel-plugin-relay": "^21.0.1",
    "estree-util-value-to-estree": "^3.5.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "unist-util-mdx-define": "^1.1.2",
    "vite": "^8.2.2",
    "yaml": "^2.9.1",
    "rolldown": "^1.2.7"
  },
  "peerDependencies": {
    "axe-core": ">=4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  }
}
