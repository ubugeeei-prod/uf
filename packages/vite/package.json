{
  "name": "@uniflowed/vite",
  "version": "0.0.0-alpha.18",
  "description": "Vite, driven by uf.config.js: every Flow module through `uf transform`, MDX, the file-system router and static rendering as Vite plugins.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubugeeei-prod/uf.git",
    "directory": "packages/vite"
  },
  "uf": {
    "builder": {
      "driver": "./driver.js",
      "preload": {
        "bun": "@uniflowed/host/bun-preload"
      }
    }
  },
  "exports": {
    ".": "./index.js",
    "./driver": "./driver.js",
    "./package.json": "./package.json",
    "./merge": "./merge.js"
  },
  "files": [
    "driver.js",
    "index.js",
    "internal",
    "merge.js",
    "!*.test.js"
  ],
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^3.23.0",
    "@uniflowed/host": "0.0.0-alpha.18",
    "@uniflowed/server": "0.0.0-alpha.18",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^3.23.0",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "axe-core": ">=4"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  }
}
